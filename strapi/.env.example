HOST=0.0.0.0
PORT=1337
APP_KEYS="tobemodified1,tobemodified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

CLIENT_URL=http://localhost:3000
PREVIEW_SECRET=preview_secret # optional, required with Next.js draft mode

# ── strapi-plugin-mcp-chat ──────────────────────────────────────────────
# Required for the AI chat + voice. Use YOUR OWN OpenAI key — never commit it.
OPENAI_API_KEY=
# The plugin registers its content tools into Strapi's native MCP server
# (enabled in config/server.ts) and the chat calls them in-process — so no MCP
# URL or admin token is needed for the chat to work.
# Optional:
OPENAI_CHAT_MODEL=gpt-4o
# Optional v2 — real browser control via Playwright MCP:
# PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
# STRAPI_ADMIN_URL=http://localhost:1337/admin
