HOST=0.0.0.0
PORT=1337
APP_KEYS="tobemodified1,tobemodified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

CLIENT_URL=http://localhost:3000
PREVIEW_SECRET=preview_secret # optional, required with Next.js draft mode

# ── strapi-plugin-mcp-chat ──────────────────────────────────────────────
# Required for the AI chat + voice. Use YOUR OWN OpenAI key — never commit it.
OPENAI_API_KEY=
# Native Strapi MCP server (enabled in config/server.ts). The chat connects to
# /mcp using an ADMIN TOKEN (not an API Token!). Create one in the admin panel
# under Settings > Admin Tokens; the MCP session inherits its permissions.
STRAPI_ADMIN_TOKEN=
# Optional:
OPENAI_CHAT_MODEL=gpt-4o
# MCP endpoint of this instance. If you change PORT, update this to match.
MCP_URL=http://localhost:1337/mcp
# Optional v2 — real browser control via Playwright MCP:
# PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
# STRAPI_ADMIN_URL=http://localhost:1337/admin
