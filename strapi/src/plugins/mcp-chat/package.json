{
  "name": "mcp-chat",
  "version": "0.1.0",
  "description": "Chat com IA dentro do admin do Strapi, usando o MCP server da própria instância.",
  "strapi": {
    "kind": "plugin",
    "name": "mcp-chat",
    "displayName": "MCP Chat",
    "description": "Converse com uma IA que enxerga e opera seu Strapi via MCP."
  },
  "scripts": {
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --target=node18 --packages=external --outfile=dist/server/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.tsx",
      "import": "./admin/src/index.tsx",
      "require": "./admin/src/index.tsx",
      "default": "./admin/src/index.tsx"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
